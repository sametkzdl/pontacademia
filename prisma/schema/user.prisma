// Kullanıcılar (Giriş Yetkisi Olanlar: Admin, Öğretmen, Öğrenci)
model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  name               String
  role               String    @default("STUDENT") // ADMIN | TEACHER | STUDENT
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  teacherProfile TeacherProfile?
  studentProfile StudentProfile?

  studentMatches  StudentTeacherMatch[] @relation("StudentMatches")
  teacherMatches  StudentTeacherMatch[] @relation("TeacherMatches")

  createdLessons  Lesson[]         @relation("CreatedLessons")
  rejectedLessons Lesson[]         @relation("RejectedLessons")
  lessonLogs      LessonLog[]      @relation("UserLessonLogs")
  lessonFeedbacks LessonFeedback[] @relation("UserLessonFeedbacks")

  requests               SupportRequest[] @relation("UserRequests")
  targetStudentRequests  SupportRequest[] @relation("TargetStudentRequests")
  targetTeacherRequests  SupportRequest[] @relation("TargetTeacherRequests")
  resolvedRequests       SupportRequest[] @relation("ResolvedByAdmin")

  @@map("users")
}
