// Öğretmen ve Öğrenci Talepleri, Şikayetleri ve Eşleşme Bırakma Formları
model SupportRequest {
  id              String   @id @default(cuid())
  userId          String   // Talebi açan kullanıcı (Öğretmen veya Öğrenci)
  userRole        String   // "TEACHER" | "STUDENT"
  
  // Talep Türü:
  // "STUDENT_COMPLAINT"      -> Öğretmenin Öğrenci Şikayeti
  // "TEACHER_DROP_STUDENT"   -> Öğretmenin Öğrenci Bırakma Talebi
  // "STUDENT_LESSON_REQUEST" -> Öğrencinin Yeni Ders Talebi
  // "STUDENT_DROP_TEACHER"   -> Öğrencinin Hoca Bırakma Talebi
  // "GENERAL_COMPLAINT"      -> Öğrencinin Genel / Eğitmen Şikayet & Destek Formu
  type            String   

  targetStudentId String?  // İlgili/Şikayet edilen öğrenci ID
  targetTeacherId String?  // İlgili/Şikayet edilen öğretmen ID
  matchId         String?  // Bırakılmak istenen eşleştirme ID
  subject         String?  // İlgili ders branşı veya talep edilen ders (Örn: "TYT Matematik")

  title           String?  // Şikayet konusu / başlık
  description     String   // Detaylı açıklama / gerekçe
  
  // Durum Yönetimi:
  // "PENDING": Beklemede
  // "IN_REVIEW": Yönetici tarafından inceleniyor
  // "APPROVED": Onaylandı (Eşleşme pasife alındı veya ders talebi kabul edildi)
  // "REJECTED": Reddedildi
  // "RESOLVED": Çözümlendi
  status          String   @default("PENDING")
  adminNotes      String?  // Yönetici açıklama/cevap notu
  resolvedAt      DateTime?
  resolvedById    String?  // İşlemi yapan admin

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation("UserRequests", fields: [userId], references: [id], onDelete: Cascade)
  targetStudent   User?    @relation("TargetStudentRequests", fields: [targetStudentId], references: [id], onDelete: SetNull)
  targetTeacher   User?    @relation("TargetTeacherRequests", fields: [targetTeacherId], references: [id], onDelete: SetNull)
  match           StudentTeacherMatch? @relation("MatchRequests", fields: [matchId], references: [id], onDelete: SetNull)
  resolvedBy      User?    @relation("ResolvedByAdmin", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@map("support_requests")
}
